// Quran font embedder.
//
//   npx tsx scripts/build-quran-font.mts
//
// Writes mobile/src/lib/quran/font-data.ts: the Amiri Quran TTF from
// @expo-google-fonts/amiri-quran as a base64 string. The tajweed page
// (lib/quran/tajweed-html.ts) loads it as a data: URI, so the WebView needs
// no file access and no font registered with the OS. That is the same on
// Android and iOS; WKWebView does not reliably see fonts the app registers.
//
// tests/quran-tajweed.test.ts compares the string with the installed file, so
// a font package upgrade without re-running this script fails the build.

import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const ttf = path.join(
  root,
  "mobile/node_modules/@expo-google-fonts/amiri-quran/400Regular/AmiriQuran_400Regular.ttf",
);
const out = path.join(root, "mobile/src/lib/quran/font-data.ts");

const b64 = readFileSync(ttf).toString("base64");
writeFileSync(
  out,
  `// GENERATED by scripts/build-quran-font.mts — do not edit.
// Amiri Quran 400 Regular, (c) The Amiri Project Authors, SIL Open Font
// License 1.1 (https://openfontlicense.org).

export const AMIRI_QURAN_TTF_BASE64 =
  "${b64}";
`,
);
console.log(`font-data.ts: ${b64.length} base64 chars`);
