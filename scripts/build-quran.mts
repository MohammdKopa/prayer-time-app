// Quran text generator.
//
//   npx tsx scripts/build-quran.mts
//
// Reads the two Tanzil files in mobile/src/lib/quran/source/ — kept there
// byte-for-byte as downloaded — and writes the modules the app imports:
//
//   mobile/src/lib/quran/text.ts   every āyah, in mushaf order, verbatim
//   mobile/src/lib/quran/meta.ts   sūrah and juzʾ tables
//
// Nothing here edits a character of the text. A line is split on its first
// two "|" and the rest is copied as it stands. tests/quran.test.ts holds the
// source file's SHA-256 and re-parses it to prove text.ts still matches it, so
// a hand edit to either file fails the build. That is the rule from the
// roadmap: one wrong character in the Quran is unforgivable.
//
// Tanzil's licence asks that its copyright block travel with every file that
// contains the text, so it is copied into the header of text.ts as well.

import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const quranDir = path.join(root, "mobile/src/lib/quran");
const textSource = path.join(quranDir, "source/tanzil-uthmani-1.1.txt");
const metaSource = path.join(quranDir, "source/tanzil-quran-data.xml");

const raw = readFileSync(textSource, "utf8");
const lines = raw.split("\n");

const ayat: string[] = [];
const copyright: string[] = [];
for (const line of lines) {
  if (line.startsWith("#")) {
    copyright.push(line);
    continue;
  }
  if (line === "") continue;
  const first = line.indexOf("|");
  const second = line.indexOf("|", first + 1);
  if (first < 0 || second < 0) throw new Error(`Unexpected line: ${line.slice(0, 40)}`);
  ayat.push(line.slice(second + 1));
}
if (ayat.length !== 6236) throw new Error(`Expected 6236 āyāt, got ${ayat.length}`);

const textModule = `// GENERATED by scripts/build-quran.mts from source/tanzil-uthmani-1.1.txt.
// Do not edit: tests/quran.test.ts fails if this differs from the source.
//
${copyright.map((l) => "//" + l.slice(1)).join("\n")}

/** Every āyah of the Quran in mushaf order, Tanzil Uthmani text v1.1, verbatim.
 *  Index = SURAHS[s - 1].start + (ayah - 1). The first āyah of every sūrah
 *  except 1 and 9 begins with the basmala, as Tanzil ships it; see
 *  \`splitBasmala\` in ./text-utils.ts for how it is shown. */
export const AYAT: readonly string[] = ${JSON.stringify(ayat, null, 0).replace(/","/g, '",\n"')};
`;
writeFileSync(path.join(quranDir, "text.ts"), textModule);

const xml = readFileSync(metaSource, "utf8");
const attr = (tag: string, name: string) => {
  const m = tag.match(new RegExp(`\\b${name}="([^"]*)"`));
  if (!m) throw new Error(`Missing ${name} in ${tag}`);
  return m[1];
};
const surahs = [...xml.matchAll(/<sura [^>]*\/>/g)].map(([tag]) => ({
  index: Number(attr(tag, "index")),
  ayahs: Number(attr(tag, "ayas")),
  start: Number(attr(tag, "start")),
  name: attr(tag, "name"),
  transliteration: attr(tag, "tname"),
  english: attr(tag, "ename"),
  revelation: attr(tag, "type") as "Meccan" | "Medinan",
}));
const juz = [...xml.matchAll(/<juz [^>]*\/>/g)].map(([tag]) => ({
  index: Number(attr(tag, "index")),
  surah: Number(attr(tag, "sura")),
  ayah: Number(attr(tag, "aya")),
}));
const sajdas = [...xml.matchAll(/<sajda [^>]*\/>/g)].map(([tag]) => ({
  surah: Number(attr(tag, "sura")),
  ayah: Number(attr(tag, "aya")),
}));
if (surahs.length !== 114 || juz.length !== 30) throw new Error("Metadata counts are off");

const metaModule = `// GENERATED by scripts/build-quran.mts from source/tanzil-quran-data.xml
// (Tanzil Quran metadata, CC BY 3.0, https://tanzil.net). Do not edit.

export interface SurahMeta {
  /** 1-based sūrah number. */
  index: number;
  ayahs: number;
  /** Offset of the sūrah's first āyah in AYAT. */
  start: number;
  /** Arabic name. */
  name: string;
  transliteration: string;
  english: string;
  revelation: "Meccan" | "Medinan";
}

export interface AyahRef {
  surah: number;
  ayah: number;
}

export const SURAHS: readonly SurahMeta[] = ${JSON.stringify(surahs, null, 2)};

/** Where each of the 30 juzʾ begins. */
export const JUZ_STARTS: readonly (AyahRef & { index: number })[] = ${JSON.stringify(juz, null, 2)};

/** The fifteen āyāt of prostration. */
export const SAJDAS: readonly AyahRef[] = ${JSON.stringify(sajdas, null, 2)};
`;
writeFileSync(path.join(quranDir, "meta.ts"), metaModule);

console.log(`text.ts: ${ayat.length} āyāt · meta.ts: ${surahs.length} sūrahs, ${juz.length} juzʾ, ${sajdas.length} sajdas`);
