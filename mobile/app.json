{
  "expo": {
    "name": "Prayer Times",
    "slug": "prayer-times",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prayer",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#05130D",
    "ios": {
      "bundleIdentifier": "app.kametrix.prayer",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "ar",
          "de",
          "tr",
          "en"
        ],
        "CFBundleDevelopmentRegion": "ar",
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": false,
        "NSLocationWhenInUseUsageDescription": "Prayer Times uses your location to calculate prayer times where you are."
      }
    },
    "android": {
      "package": "app.kametrix.prayer",
      "adaptiveIcon": {
        "backgroundColor": "#05130D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "ar": "./locales/ar.json",
      "de": "./locales/de.json",
      "tr": "./locales/tr.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Prayer Times uses your location to calculate prayer times where you are. It is never sent anywhere."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9B871",
          "sounds": [
            "./assets/sounds/adhan_full.ogg",
            "./assets/sounds/adhan_short.ogg"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05130D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/reem-kufi/400Regular/ReemKufi_400Regular.ttf",
            "./node_modules/@expo-google-fonts/reem-kufi/600SemiBold/ReemKufi_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/noto-naskh-arabic/400Regular/NotoNaskhArabic_400Regular.ttf",
            "./node_modules/@expo-google-fonts/noto-naskh-arabic/500Medium/NotoNaskhArabic_500Medium.ttf",
            "./node_modules/@expo-google-fonts/amiri/400Regular/Amiri_400Regular.ttf"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class expo.modules.prayersilence.** { *; }\n-keep class expo.modules.prayerwidget.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "kametrix",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b476431f-ff00-4b28-b354-6cd1ba6f0a8f"
      }
    }
  }
}
