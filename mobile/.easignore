# What EAS Build uploads. This file REPLACES .gitignore for the upload, so the
# usual generated directories have to be named here too or they get sent.
node_modules/
android/
ios/
.expo/

# Local build artifacts — the APKs we hand out for testing. 800 MB of them.
build-out/
*.apk
*.aab

# The web app and its assets are not part of the Android build.
../dist/
../docs/
../node_modules/
../.next/
